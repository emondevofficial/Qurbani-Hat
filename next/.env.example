# =============================================================================
# QurbaniHat (Next.js) — Environment Variable Template
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
#   cp next/.env.example next/.env.local
#
# The same variables must also be set in the hosting dashboard for production
# (Vercel -> Project -> Settings -> Environment Variables -> Production).
# Never copy the localhost values below into the hosting dashboard.
# Verify any deployment with:  GET https://<your-domain>/api/health
# =============================================================================

# --- MongoDB (REQUIRED — Better Auth persistence) ----------------------------
# Free MongoDB Atlas cluster: https://cloud.mongodb.com
# Atlas > Connect > Drivers > copy the connection string.
# Keep the database name inside the URI or set MONGODB_DB separately.
#
# Atlas > Network Access must also allow the deployment's IP addresses (Vercel
# functions use dynamic egress IPs; use 0.0.0.0/0 for this assignment). If
# MongoDB is unreachable, EVERY auth endpoint fails before Google is ever
# contacted and /api/health reports mongodb.reachable = false.
MONGODB_URI=
MONGODB_DB=Qurbani-Hat

# --- Better Auth (REQUIRED) --------------------------------------------------
# Signing/encryption secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value in production than in local development.
BETTER_AUTH_SECRET=

# Public base URL of THIS app. Better Auth uses it to build the OAuth callback
# URL and the trusted-origins list. Never hardcode it in source code.
#
#   local development : http://localhost:3000   <- must be `localhost`, NOT 0.0.0.0
#   production/Vercel : https://qurbanihat-next.vercel.app
#
# NOTE: the Next.js server binds to localhost:3000 so LAN/preview clients can
# reach it (`npm run dev:lan`), but a browser can never open `http://0.0.0.0:3000`
# (Chrome: ERR_ADDRESS_INVALID -108). lib/app-url.ts rewrites any bind-only host
# (0.0.0.0, ::, 127.0.0.1) to `localhost` automatically.
#
# On a hosted runtime a loopback value is IGNORED — the deployment's own origin
# wins — so a locally-copied value can never cause `redirect_uri_mismatch`.
BETTER_AUTH_URL=http://localhost:3000

# Client-visible copy of the same URL (used by the Better Auth browser client).
# Prefer NEXT_PUBLIC_BETTER_AUTH_URL; NEXT_PUBLIC_APP_URL remains supported as a legacy alias.
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (REQUIRED for "Continue with Google") ----------------------
# https://console.cloud.google.com/apis/credentials
#   1. Create Credentials > OAuth client ID > Web application
#   2. Authorized JavaScript origins:
#        http://localhost:3000
#        https://qurbanihat-next.vercel.app
#   3. Authorized redirect URIs:
#        http://localhost:3000/api/auth/callback/google            (development)
#        https://qurbanihat-next.vercel.app/api/auth/callback/google (production)
#   4. On the host, set the production values as separate environment variables —
#      never overwrite them with the localhost values.
#
# SERVER-ONLY. Do NOT rename these to NEXT_PUBLIC_*: the secret would then be
# inlined into the browser bundle. Confirm the exact redirect URI Better Auth
# sends by opening /api/health (`google.expectedRedirectUri`).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
